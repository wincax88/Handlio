# Copy to .env. Development is loopback-only; production requires HTTPS and SMTP.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATA_DIR=.data
# Explicit trusted proxy IPs/CIDRs; leave blank for local development.
TRUST_PROXY=
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Handlio <hello@example.com>
SUPPORT_EMAIL=support@example.com
# Explicit metadata-only operations allowlist; requires recent email verification.
OPS_EMAILS=
# Generic billing adapter: create checkout and GET authoritative transaction state.
BILLING_ADAPTER_URL=
BILLING_ADAPTER_TOKEN=
BILLING_WEBHOOK_SECRET=
# AI adapter receives sanitized images and must return the documented structured schema.
AI_ADAPTER_URL=
AI_ADAPTER_TOKEN=
AI_PRIVACY_NOTICE=
# Browser executable for PDF rendering, or install Playwright Chromium.
CHROMIUM_EXECUTABLE_PATH=
