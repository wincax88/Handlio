# Copy to .env. Development is loopback-only; production requires HTTPS and SMTP.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATA_DIR=.data
# Explicit trusted proxy IPs/CIDRs; leave blank for local development.
TRUST_PROXY=
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Resend production configuration. Blank provider uses SMTP if configured, otherwise local development.
MAIL_PROVIDER=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Handlio <notifications@handlio.cloud>
MAIL_AUTH_FROM=Handlio <auth@handlio.cloud>
# Set only after confirming the mailbox can receive replies.
MAIL_REPLY_TO=
SUPPORT_EMAIL=support@handlio.cloud
# Explicit metadata-only operations allowlist; requires recent email verification.
OPS_EMAILS=
# Generic billing adapter: create checkout and GET authoritative transaction state.
BILLING_ADAPTER_URL=
BILLING_ADAPTER_TOKEN=
BILLING_WEBHOOK_SECRET=
# Dodo hosted one-time checkout. Set BILLING_PROVIDER=dodo to select it.
# Keep test_mode on a separate non-production instance with its own DATA_DIR.
# Sealos production maps separate DODO_LIVE_* GitHub Secrets to these runtime names;
# see docs/providers.md. Never replace the sandbox credentials with live credentials.
BILLING_PROVIDER=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PROJECT_PRODUCT_ID=
DODO_RENEWAL_PRODUCT_ID=
# DeepSeek vision: server-side key only. Blank AI_PROVIDER auto-selects an existing
# AI_ADAPTER_URL first, otherwise DeepSeek when its API key is set.
AI_PROVIDER=
DEEPSEEK_API_KEY=
# Optional notice override; DeepSeek has a built-in disclosure before user consent.
# Legacy AI adapter receives sanitized images and returns the documented schema.
AI_ADAPTER_URL=
AI_ADAPTER_TOKEN=
AI_PRIVACY_NOTICE=
# Browser executable for PDF rendering, or install Playwright Chromium.
CHROMIUM_EXECUTABLE_PATH=
# AI cost accounting: USD caps, independent of project purchase or step allowance.
AI_MAX_STEP_COST_USD=0.05
AI_DAILY_BUDGET_USD=100
# A base64 32-byte AES key; store separately from backup files. Both settings enable daily backup.
BACKUP_KEY=
BACKUP_DIRECTORY=
BACKUP_MAX_BYTES=53687091200
OPERATOR_NAME=Handlio Team
OPERATOR_REGION=Mainland China
# Set to the verified production data region; do not infer it from operator location.
DATA_HOSTING_REGION=
